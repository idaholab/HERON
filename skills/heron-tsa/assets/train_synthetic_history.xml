<?xml version="1.0" ?>
<Simulation verbosity="debug">
  <!-- Train a SyntheticHistory ROM for HERON. Copy this and edit.
       Data: Data.csv indexes one history file per year (references/training-data.md),
       each with columns Time, PRICE, LOAD at hourly steps.
       Outputs (in WorkingDir):
         synth.pk            the model; point HERON's <ARMA> at this
         romMeta.xml         trained parameters and clusters
         synthetic.csv       sampled histories, for references/validation.md
       Run: raven_framework train_synthetic_history.xml -->

  <RunInfo>
    <WorkingDir>.</WorkingDir>
    <Sequence>load, train, meta, serialize, sample</Sequence>
  </RunInfo>

  <Steps>
    <IOStep name="load">
      <Input class="Files" type="">data</Input>
      <Output class="DataObjects" type="HistorySet">training</Output>
    </IOStep>
    <RomTrainer name="train">
      <Input class="DataObjects" type="HistorySet">training</Input>
      <Output class="Models" type="ROM">synth</Output>
    </RomTrainer>
    <IOStep name="meta">
      <Input class="Models" type="ROM">synth</Input>
      <Output class="DataObjects" type="DataSet">romMeta</Output>
      <Output class="OutStreams" type="Print">romMeta</Output>
    </IOStep>
    <IOStep name="serialize">
      <Input class="Models" type="ROM">synth</Input>
      <Output class="Files" type="">pk</Output>
    </IOStep>
    <MultiRun name="sample">
      <Input class="DataObjects" type="PointSet">placeholder</Input>
      <Model class="Models" type="ROM">synth</Model>
      <Sampler class="Samplers" type="MonteCarlo">mc</Sampler>
      <Output class="DataObjects" type="DataSet">synthetic</Output>
      <Output class="OutStreams" type="Print">synthetic</Output>
    </MultiRun>
  </Steps>

  <Files>
    <Input name="data">Data.csv</Input>
    <Input name="pk">synth.pk</Input>
  </Files>

  <DataObjects>
    <PointSet name="placeholder">
      <Input>scaling</Input>
      <Output>OutputPlaceHolder</Output>
    </PointSet>
    <HistorySet name="training">
      <Input>scaling, Year</Input>                <!-- index-file columns, less "filename" -->
      <Output>PRICE, LOAD, Time</Output>
      <options><pivotParameter>Time</pivotParameter></options>
    </HistorySet>
    <!-- Samples, indexed by year and time. For a single-year model, drop Year
         from "training" and drop the Year index here. -->
    <DataSet name="synthetic">
      <Input>scaling</Input>
      <Output>PRICE, LOAD</Output>
      <Index var="Time">PRICE, LOAD</Index>
      <Index var="Year">PRICE, LOAD</Index>
    </DataSet>
    <DataSet name="romMeta"/>
  </DataObjects>

  <Models>
    <ROM name="synth" subType="SyntheticHistory">
      <Target>PRICE, LOAD, Time</Target>          <!-- signals, plus the pivot -->
      <Features>scaling</Features>                <!-- HERON requires exactly this -->
      <pivotParameter>Time</pivotParameter>

      <!-- Global algorithms are fitted first, on the whole signal, then the rest per
           segment; each group top to bottom. Sampling reverses this
           (references/algorithms.md). -->
      <preserveCDF target="PRICE, LOAD" global="True"/>  <!-- samples keep each signal's distribution -->
      <fourier target="LOAD" global="True">       <!-- cycles longer than a segment: whole year -->
        <periods>8760, 4380, 168</periods>        <!-- in pivot units: hours -->
      </fourier>
      <fourier target="PRICE, LOAD">              <!-- daily shape, refitted per segment -->
        <periods>24, 12, 8</periods>
      </fourier>
      <gaussianize target="PRICE, LOAD"/>         <!-- residual to a normal distribution -->
      <arma target="PRICE, LOAD" seed="42">       <!-- stochastic part -->
        <P>2</P>
        <Q>1</Q>
      </arma>

      <!-- Daily segments clustered into representative days; years interpolated
           between the ones in Data.csv (references/segmenting.md). -->
      <Segment grouping="interpolate">
        <macroParameter>Year</macroParameter>
        <Classifier class="Models" type="PostProcessor">classifier</Classifier>
        <subspace pivotLength="24" shift="zero">Time</subspace>
        <evalMode>full</evalMode>
        <evaluationClusterChoice>random</evaluationClusterChoice>
      </Segment>
    </ROM>

    <PostProcessor name="classifier" subType="DataMining">
      <KDD labelFeature="labels" lib="SciKitLearn">
        <Features>PRICE, LOAD</Features>
        <SKLtype>cluster|KMeans</SKLtype>
        <n_clusters>8</n_clusters>                <!-- representative days per year -->
        <tol>1E-12</tol>
        <init>k-means++</init>
        <random_state>3</random_state>
      </KDD>
    </PostProcessor>
  </Models>

  <Samplers>
    <MonteCarlo name="mc">
      <samplerInit>
        <limit>10</limit>                         <!-- samples to compare against the data -->
        <initialSeed>42</initialSeed>
      </samplerInit>
      <constant name="scaling">1.0</constant>
    </MonteCarlo>
  </Samplers>

  <OutStreams>
    <Print name="romMeta">
      <type>csv</type>
      <source>romMeta</source>
    </Print>
    <Print name="synthetic">
      <type>csv</type>
      <source>synthetic</source>
    </Print>
  </OutStreams>
</Simulation>
